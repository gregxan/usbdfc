{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (release)",
      "type": "shell",
      "command": "cmake --preset release; cmake --build --preset release",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build (diag)",
      "type": "shell",
      "command": "cmake --preset diag; cmake --build --preset diag",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build test target (Pico 2)",
      "type": "shell",
      "command": "cmake --preset release; cmake --build --preset release",
      "options": { "cwd": "${workspaceFolder}/test_target" },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Flash with picotool (board in BOOTSEL)",
      "type": "shell",
      "command": "picotool load -x build/release/firmware.uf2",
      "problemMatcher": []
    },
    {
      "label": "Flash diag build with picotool (no button)",
      "type": "shell",
      "command": "picotool load -x -f build/diag/firmware.uf2",
      "problemMatcher": []
    },
    {
      "label": "Flash test target with picotool (Pico 2 in BOOTSEL)",
      "type": "shell",
      "command": "picotool load -x test_target/build/release/test_target.uf2",
      "problemMatcher": []
    },
    {
      "label": "Flash with OpenOCD / debug probe (release)",
      "type": "shell",
      "command": "openocd -f interface/cmsis-dap.cfg -f target/rp2350.cfg -c \"adapter speed 5000\" -c \"program build/release/firmware.elf verify reset exit\"",
      "problemMatcher": []
    }
  ]
}
