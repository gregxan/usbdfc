{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (release)",
      "type": "shell",
      "command": "cmake --preset release; cmake --build --preset release",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Flash with picotool (release)",
      "type": "shell",
      "command": "picotool load -x -f build/release/firmware.uf2",
      "problemMatcher": []
    },
    {
      "label": "Flash with OpenOCD / debug probe (release)",
      "type": "shell",
      "command": "openocd -f interface/cmsis-dap.cfg -f target/rp2350.cfg -c \"adapter speed 5000\" -c \"program build/release/firmware.elf verify reset exit\"",
      "problemMatcher": []
    }
  ]
}
